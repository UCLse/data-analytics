{
  "name": "Heat Cascade Python course",
  "image": "mcr.microsoft.com/devcontainers/python:3-3.12-bookworm",
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "python scripts/setup-codespaces.py",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/heat-cascade/.venv/bin/python"
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24",
      "pnpmVersion": "none"
    }
  }
}
